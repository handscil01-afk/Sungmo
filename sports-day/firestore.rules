rules_version = '2';
// 가을운동회 점수판 (sports-day) Firestore 규칙
// 파이어베이스 콘솔 → Firestore Database → 규칙 탭에 그대로 붙여 넣고 게시합니다.
// 규칙 버전 12 (js/config.js 의 RULES_VER 와 같은 숫자). 마스터 기기가 접속할 때 main/meta/rules 에 이 번호를 써 보고, 막히면 '규칙이 예전 것'이라고 알려 줌
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function open() { return request.time < timestamp.date(2026, 11, 7); }
    function isMaster() {
      return signedIn() && exists(/databases/$(database)/documents/undonghoe5/main/masters/$(request.auth.uid));
    }
    function hasRole() {
      return signedIn() && exists(/databases/$(database)/documents/undonghoe5/main/roles/$(request.auth.uid));
    }
    function myRole() {
      return get(/databases/$(database)/documents/undonghoe5/main/roles/$(request.auth.uid)).data;
    }
    // 한 기기에 여러 역할: events(심판)·helpers(기록 도우미)·timers(계시원)·coach(감독 팀)
    function refereeOf(ev) { return hasRole() && (ev in myRole().get('events', []) || ev in myRole().get('helpers', [])); }
    function timerOf(ev) { return hasRole() && ev in myRole().get('timers', []); }
    function coachOf(team) {
      return hasRole() && (myRole().get('coach', '') == team || (myRole().get('role', '') == 'coach' && myRole().get('team', '') == team));
    }
    // 담당자 명단에서 이름을 골라 들어올 때: 자기 기기에, 명단에 적힌 역할 그대로만 쓸 수 있음
    function presetOk(uid) {
      let d = request.resource.data;
      let p = get(/databases/$(database)/documents/undonghoe5/main/presets/$(d.preset)).data;
      return signedIn() && request.auth.uid == uid
        && d.keys().hasOnly(['preset', 'name', 'coach', 'events', 'helpers', 'timers', 'board', 'cast', 'monitor', 'at', 'by'])
        && d.coach == p.coach && d.events == p.events && d.helpers == p.helpers
        && d.timers == p.timers && d.board == p.board && d.cast == p.cast
        && d.get('monitor', false) == p.get('monitor', false);
    }
    // 기록의 종목을 다른 종목으로 바꿔치기하지 못하게 함
    function sameEvent() { return resource == null || resource.data.event == request.resource.data.event; }

    // 마스터 비밀번호: 콘솔에서만 넣고 아무도 읽을 수 없음
    match /undonghoe5/secret { allow read, write: if false; }

    // 명단·팀 이름·점수 설정: 마스터만 바꿈
    match /undonghoe5/config {
      allow read: if signedIn();
      allow write: if open() && isMaster();
    }
    // 마스터 기기 목록: 비밀번호가 맞거나, 이미 마스터인 기기가 다른 기기에 권한을 줄 때만 만들 수 있음
    match /undonghoe5/main/masters/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isMaster());
      allow create: if open() && signedIn() && (isMaster()
        || (request.auth.uid == uid && request.resource.data.pw == get(/databases/$(database)/documents/undonghoe5/secret).data.masterPw));
      allow update, delete: if open() && isMaster();
    }
    // 기기별 역할: 마스터가 정하거나, 담당자 명단에서 이름을 골라 들어옴
    match /undonghoe5/main/roles/{uid} {
      allow read: if signedIn();
      allow create, update: if open() && (isMaster() || presetOk(uid));
      allow delete: if open() && (isMaster() || (signedIn() && request.auth.uid == uid));
    }
    // 담당자 명단(미리 정한 역할): 마스터만 바꿈
    match /undonghoe5/main/presets/{id} {
      allow read: if signedIn();
      allow write: if open() && isMaster();
    }
    // 접속한 기기: 자기 기기 정보만 씀 (마스터는 지울 수 있음)
    match /undonghoe5/main/devices/{uid} {
      allow read: if signedIn();
      allow write: if open() && signedIn() && (request.auth.uid == uid || isMaster());
    }
    // 개인전·단체전 기록: 마스터 또는 그 종목을 맡은 심판·기록 도우미만
    match /undonghoe5/main/indiv/{id} {
      allow read: if signedIn();
      allow create, update: if open() && sameEvent() && id.matches(request.resource.data.event + '_.*')
        && (isMaster() || refereeOf(request.resource.data.event));
    }
    match /undonghoe5/main/matches/{id} {
      allow read: if signedIn();
      allow create, update: if open() && sameEvent() && id.matches(request.resource.data.event + '_.*')
        && (isMaster() || refereeOf(request.resource.data.event));
    }
    // 단체전 출전 순서: 마스터 또는 그 팀 감독만
    match /undonghoe5/main/orders/{id} {
      allow read: if signedIn();
      allow write: if open() && id == request.resource.data.event + '_' + request.resource.data.team
        && (isMaster() || coachOf(request.resource.data.team));
    }
    // 감독의 우리 팀 선수 호출(안내판에 띄움): 마스터 또는 그 팀 감독만 만들고 고침. 지우기(초기화)는 마스터만
    match /undonghoe5/main/ccalls/{id} {
      allow read: if signedIn();
      allow create, update: if open() && id == request.resource.data.event + '_' + request.resource.data.team
        && (isMaster() || coachOf(request.resource.data.team));
      allow delete: if open() && isMaster();
    }
    // 안내판 선수 호출·계시 기록: 마스터, 그 종목 심판·기록 도우미·계시원
    match /undonghoe5/main/calls/{ev} {
      allow read: if signedIn();
      allow write: if open() && (isMaster() || refereeOf(ev) || timerOf(ev));
    }
    // 문자 무전·긴급 호출: 역할이 있는 기기만 자기 이름으로 보냄
    match /undonghoe5/main/msgs/{id} {
      allow read: if signedIn();
      allow create: if open() && (isMaster() || hasRole()) && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 300;
      allow update, delete: if open() && isMaster();
    }
    // 개인전 부스 대기열: 마스터 또는 그 종목 심판·기록 도우미. 지우기(초기화)는 마스터만
    match /undonghoe5/main/queues/{ev} {
      allow read: if signedIn();
      allow create, update: if open() && ev == request.resource.data.event && (isMaster() || refereeOf(ev));
      allow delete: if open() && isMaster();
    }
    // 과녁판 사진 등 큰 자료: 마스터만 올리고 지움
    match /undonghoe5/main/assets/{id} {
      allow read: if signedIn();
      allow create, update, delete: if open() && isMaster();
    }
    // 규칙 확인용 표식(버전): 마스터 기기가 접속할 때 한 번 씀. 쓸 수 없으면 서버 규칙이 예전 것이라는 뜻
    match /undonghoe5/main/meta/{id} {
      allow read: if signedIn();
      allow write: if open() && isMaster();
    }
    // 불참 표시: 마스터와 역할이 있는 진행요원
    match /undonghoe5/main/absent/{pid} {
      allow read: if signedIn();
      allow write: if open() && (isMaster() || hasRole());
    }
  }
}
